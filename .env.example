###############################################
# Environment Variables - Production
# Capstone Project: Educational Animal Drawing Game
###############################################
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Variable bertanda [REQUIRED] wajib diisi.

# ============================================
# Port Mapping (Host)
# ============================================
# Port yang digunakan untuk mengakses service dari host/Cloudflare Tunnel
BACKEND_PORT=3308
ADMIN_PORT=3317
POSTGRES_PORT=5433
REDIS_PORT=6379

# ============================================
# PostgreSQL Configuration [REQUIRED]
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_yang_kuat
POSTGRES_DB=capstone_project

# ============================================
# JWT Authentication [REQUIRED]
# ============================================
JWT_ACCESS_SECRET=ganti_dengan_secret_yang_kuat_minimal_64_karakter
JWT_REFRESH_SECRET=ganti_dengan_secret_berbeda_minimal_64_karakter
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# ============================================
# Cloudflare R2 Storage
# ============================================
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ============================================
# Firebase (Push Notifications)
# ============================================
# Gunakan salah satu: path ke file service account ATAU individual credentials
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
