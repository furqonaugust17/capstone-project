# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Supabase Connection Pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Authentication Secrets
JWT_SECRET="your_super_secret_jwt_key_for_access_token_min_32_chars"
JWT_REFRESH_SECRET="your_super_secret_jwt_key_for_refresh_token_min_32_chars"

# Firebase Admin SDK Configuration (for Cloud Messaging/Notifications)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# OR use individual credentials if path is not provided:
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 Configuration (for Storage)
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="your_bucket_name"
R2_PUBLIC_URL="https://pub-<id>.r2.dev"

# Redis Configuration (Upstash)
REDIS_URL="rediss://default:YOUR-PASSWORD@YOUR-ENDPOINT:6379"

# Vercel Cron Job Secret
CRON_SECRET="your_super_secret_cron_key_for_vercel_cron"

# Logging Configuration
LOG_LEVEL="debug" # 'info' for production, 'debug' for development
